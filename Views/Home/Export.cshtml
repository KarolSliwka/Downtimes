@model DowntimeTracker.Models.Downtime
@{
    ViewData["Title"] = " - Export";
}
<!-- Top section -->
<div>
    <div class="row my-2">
        <div>
            <a asp-action="Index" class="btn-back"><i class="bi bi-chevron-left me-1"></i>Home</a>
        </div>
    </div>
    <div class="row page-title">
        <h1>Export</h1>
    </div>
    <!-- Separate stripe -->
    <hr class="stripe" />
</div>
<!-- Create form -->
<div class="container py-4">
    <form method="POST" asp-controller="Home">
        <!-- Visible fields -->
        <div class="row">
        <!-- Reason -->
            <div class="col-12 col-sm-6">
                <div class="form-group mb-3">
                    <label asp-for="Year" class="form-label"></label>
                    <select asp-for="Year" class="form-control" id="export_year" onchange="GetWeeks()">
                        <option value="">Select..</option>
                        @foreach (var item in ViewBag.Year)
                        {
                            <option value="@item">@item</option>
                        }
                    </select>
                    <span asp-validation-for="Year" class="text-danger"></span>
                </div>
            </div>
        <!-- Machine -->
            <div class="col-12 col-sm-6">
                <div class="row">
                    <div class="col-12 col-sm-6">
                        <div class="form-group mb-3">
                            <label class="form-label">Week From</label>
                            <select class="form-control" id="export_week_from" name="export_week_from" formnovalidate="formnovalidate" disabled required>
                                <option value="">Select..</option>
                                @foreach (var item in ViewBag.Week)
                                {
                                    <option value="@item">@item</option>
                                }
                            </select>
                            <span asp-validation-for="Week" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-12 col-sm-6">
                        <div class="form-group mb-3">
                            <label class="form-label">Week To</label>
                            <select class="form-control" id="export_week_to" name="export_week_to" formnovalidate="formnovalidate" disabled required>
                                <option value="">Select..</option>
                                @foreach (var item in ViewBag.Week)
                                {
                                    <option value="@item">@item</option>
                                }
                            </select>
                            <span asp-validation-for="Week" class="text-danger"></span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="row buttons">
            <div class="col-12 col-sm-12 col-md-6">
                <input id="export_clear_btn" type="reset" value="Clear" class="btn btn-reset" />
            </div>
            <div class="col-12 col-sm-12 col-md-3">
                <div id="export_submit_btn">
                    <button type="submit" class="btn btn-send" asp-action="ExportToCSV">Export Raptor</button>
                </div>
            </div>
            <div class="col-12 col-sm-12 col-md-3">
                <div id="export_submit_btn">
                    <button type="submit" class="btn btn-send" asp-action="ExportToExcel">
                        <i class="bi bi-file-earmark-spreadsheet me-2"></i>Export Excel
                    </button>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}