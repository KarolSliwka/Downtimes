<div class="col-12 col-sm-12 col-md-4 col-lg-3 col-xl-3 col-xxl-2 mb-4">
    <div class="d-flex flex-column flex-shrink-0 p-4 bg-body-tertiary side-menu rounded-2">
        <ul class="nav nav-pills flex-column mb-auto">
            <li class="nav-item sidebar-link">
                <a class="nav-link text-dark bg-white" asp-controller="Acceptations" asp-action="Opened">
                    <i class="bi bi-app-indicator me-2"></i>Otwarte (@ViewBag.OpenedCounter)
                </a>
            </li>
            <li class="nav-item sidebar-link">
                <a class="nav-link text-dark bg-warning" asp-controller="Acceptations" asp-action="Index">
                    <i class="bi bi-clock-fill me-2"></i>Oczekujące (@ViewBag.AwaitingCounter)
                </a>
            </li>
            <li class="nav-item sidebar-link">
                <a class="nav-link text-white bg-success" asp-controller="Acceptations" asp-action="Accepted">
                    <i class="bi bi-check-circle-fill me-2"></i>Zaakecptowane (@ViewBag.AcceptedCounter)
                </a>
            </li>
            <li class="nav-item sidebar-link">
                <a class="nav-link text-white bg-danger" asp-controller="Acceptations" asp-action="Refused">
                    <i class="bi bi-x-circle-fill me-2"></i>Odrzucone (@ViewBag.RefusedCounter)
                </a>
            </li>
        </ul>
    </div>
</div>