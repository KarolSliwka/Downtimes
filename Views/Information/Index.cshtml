@model IEnumerable<DowntimeTracker.Models.InfoRecord>

@{
    ViewData["Title"] = " - Informacje";
    ViewData["Subtitle"] = "Informacje";
}
<!-- categories reason explanation list -->
<div class="container-fluid my-4">
    <h1>@ViewData["Subtitle"]</h1>
    <hr class="title-line"/>
    <div class="information my-4">
        @if(Model.Count() > 0) 
        {
            <!-- Categories & Reasons Explanation -->
            <div class="accordion" id="tip1">
                <div class="accordion-item">
                    <h6 class="accordion-header">
                        <button class="accordion-button" type="button" data-bs-toggle="collapse" 
                            data-bs-target="#tipb1" aria-expanded="true" aria-controls="tipb1" value="tedt">Objaśnienia Kategorii i Powodów</button>
                    </h6>
                    <div id="tipb1" class="accordion-collapse collapse show" data-bs-parent="#tip1">
                        <div class="accordion-body p-0">
                            <!-- Categories table -->
                            <div class="table-responsive">
                                <table class="table table-striped mb-0">
                                    <!-- headers -->
                                    <thead>
                                        <tr class="text-nowrap">
                                            <th>#</th>
                                            <th>@Html.DisplayNameFor(model => model.Category)</th>
                                            <th>@Html.DisplayNameFor(model => model.CorporateReason)</th>
                                            <th>@Html.DisplayNameFor(model => model.M4Category)</th>
                                            <th>@Html.DisplayNameFor(model => model.IsClaimable)</th>
                                            <th>@Html.DisplayNameFor(model => model.Type)</th>
                                            <th>@Html.DisplayNameFor(model => model.Example)</th>
                                            <th>@Html.DisplayNameFor(model => model.Responsible)</th>
                                        </tr>
                                    </thead>
                                    <!-- content -->
                                    <tbody class="table-group-divider">
                                    @{ int rowNo = 0; }
                                    @foreach(var item in Model.OrderBy(o => o.Category).ThenBy(o => o.CorporateReason))
                                    {
                                    <tr class="align-middle">
                                        <th scope="row">@(rowNo += 1)</th>
                                        <td class="text-nowrap">@item.Category</td>
                                        <td class="text-nowrap">@item.CorporateReason</td>
                                        <td class="text-nowrap">@item.M4Category</td>
                                        @if(item.IsClaimable == true){
                                            <td>Tak</td>
                                        } 
                                        else {
                                            <td>Nie</td>
                                        }
                                        <td class="text-nowrap">@item.Type</td>
                                        <td>@item.Explanation</td>
                                        <td class="text-end">@item.Responsible</td>
                                    </tr>
                                    }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>    
            </div>
        }
        else
        {
            <p class="lead missing-text">Brak informacji do wyświetlenia</p>
        }
        @*<!-- tip 2 -->
        <div class="accordion" id="tip2">
            <div class="accordion-item">
                <h2 class="accordion-header">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#tipb2" aria-expanded="false" aria-controls="tipb2">Tip 2</button>
                </h2>
                <div id="tipb2" class="accordion-collapse collapse" data-bs-parent="#tip2">
                    <div class="accordion-body">
                    </div>
                </div>
            </div>    
        </div>*@
    </div>
</div>